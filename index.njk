---
layout: base.njk
pagina: home
---
{% import "macros.njk" as m %}
{% set primero = collections.escritos[0] %}
{% set pilares = ["Ella va llegando", "Lo que nadie ve", "Volver a empezar", "Para ti", "Canciones para...", "La vida también es esto", "Historias"] %}

<section class="wrap hero">
  <p class="kicker">Publicación digital · Escritos, cartas y canciones</p>
  <h1>Ella va llegando</h1>
  <div class="hero-sub">
    <p class="cita">Un lugar para quienes todavía están llegando.</p>
    <p class="desc">Escritos para los días en que la vida todavía no se parece a lo que imaginaste.</p>
  </div>
</section>

<div class="lema">
  <div class="signo"><span class="s1"></span><span class="s2"></span><span class="s3"></span></div>
  <p>No estás tarde. Estás llegando.</p>
</div>

{% if primero %}
<section class="wrap empieza">
  <div class="empieza-grid">
    <div class="empieza-foto">
      {% if primero.data.image %}
      <img src="{{ primero.data.image }}" alt="{{ primero.data.image_caption or primero.data.title }}" style="width:100%;height:100%;object-fit:cover">
      {% else %}
      <div class="placeholder-foto"><span>{{ primero.data.image_caption or 'fotografía' }}</span></div>
      {% endif %}
    </div>
    <div>
      <p class="kicker">Empieza aquí</p>
      <h2>{{ primero.data.title }}</h2>
      <p class="fecha" style="margin-top:20px">{{ primero.date | fechaBonita }} · Ella va llegando</p>
      <p class="cita-grande" style="margin-top:26px">{{ primero.data.excerpt }}</p>
      <a class="link-flecha" style="margin-top:34px" href="/escritos/{{ primero.fileSlug }}/">Leer el primer escrito <span>→</span></a>
    </div>
  </div>
</section>
{% endif %}

<section class="wrap rejilla-escritos">
  <div class="section-titulo">
    <h2>Últimos escritos</h2>
    <a class="ver-todos" href="/escritos/">Ver todos →</a>
  </div>
  <div class="tarjetas">
    {% for e in collections.escritos %}
      {% if loop.index <= 3 %}{{ m.tarjeta(e) }}{% endif %}
    {% endfor %}
  </div>
</section>

<section class="pilares">
  <div class="wrap">
    <p class="kicker">Explorar por pilar</p>
    <div class="pilares-botones">
      {% for p in pilares %}
      <a class="pildora" href="/escritos/?cat={{ p | urlencode }}">{{ p }}</a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="wrap comunidad">
  <div class="comunidad-grid">
    <div>
      <p class="kicker">Comunidad</p>
      <p class="grande">Los escritos completos viven aquí. En Instagram y Facebook comparto fragmentos.</p>
    </div>
    <div class="botones-sociales">
      <a class="boton-outline" href="https://instagram.com" target="_blank" rel="noopener">Instagram</a>
      <a class="boton-outline" href="https://facebook.com" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
</section>
