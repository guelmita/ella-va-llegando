{% macro tarjeta(e) %}
<article class="tarjeta">
  {% if e.data.image %}
  <div class="tarjeta-foto"><img src="{{ e.data.image }}" alt="{{ e.data.image_caption or e.data.title }}" style="width:100%;height:100%;object-fit:cover"></div>
  {% else %}
  <div class="tarjeta-foto placeholder-foto"><span>{{ e.data.image_caption or 'fotografía' }}</span></div>
  {% endif %}
  <p class="categoria">{{ e.data.category }}</p>
  <h3><a href="/escritos/{{ e.fileSlug }}/" style="color:inherit">{{ e.data.title }}</a></h3>
  <p class="fecha">{{ e.date | fechaBonita }}</p>
  <p class="extracto">{{ e.data.excerpt }}</p>
  <a class="link-flecha" href="/escritos/{{ e.fileSlug }}/">Leer <span>→</span></a>
</article>
{% endmacro %}

{% macro fila(e) %}
<a class="fila-escrito" href="/escritos/{{ e.fileSlug }}/" data-categoria="{{ e.data.category }}">
  <span class="fecha">{{ e.date | fechaBonita }}</span>
  <div class="fila-info">
    <h3>{{ e.data.title }}</h3>
    <span class="extracto" style="display:block">{{ e.data.excerpt }}</span>
  </div>
  <span class="categoria">{{ e.data.category }}</span>
</a>
{% endmacro %}
